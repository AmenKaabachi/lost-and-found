{
  "name": "lost-and-found",
  "version": "0.1.0",
  "private": true,
  "description": "Initial scaffold for the LOST & FOUND campus platform",
  "type": "module",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:coverage": "node node_modules/vitest/vitest.mjs run --coverage",
    "test:demo": "node node_modules/vitest/vitest.mjs run backend/src/errors/tests/integration",
    "test:errors": "node node_modules/vitest/vitest.mjs run backend/src/errors/tests",
    "test:errors:coverage": "node node_modules/vitest/vitest.mjs run --coverage backend/src/errors/tests"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pino": "^9.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
